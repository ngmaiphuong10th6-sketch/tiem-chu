import React, { useState, useEffect } from 'react';
import { 
  Sparkles, BookOpen, PenTool, Key, User, 
  ChevronRight, Lock, Download, Play, 
  Brain, LayoutDashboard, FileText, 
  LogOut, ShoppingBag, X,
  Heart, Star, GraduationCap,
  Eye, ListChecks, ArrowLeft, Clock, 
  Feather, Library, Mail, BarChart3, Users, PlusCircle, Video
} from 'lucide-react';

// --- Cấu hình API ---
const apiKey = ""; 

// --- Dữ liệu Mở rộng ---
const SUBJECTS = ["Văn", "Sử", "Địa"];
const GRADES = ["10", "11", "12"];

const DOCUMENTS = [
  { id: 'd1', title: "Ebook NLVH: Tư duy từ khóa 9+", price: 150000, category: "Văn", grade: "12", pages: 120, format: "PDF", code: "VAN12_9PLUS", description: "Cẩm nang chuyên sâu về các kỹ thuật khai thác từ khóa trong nghị luận văn học.", preview: "Đây là nội dung xem trước của tài liệu: Tư duy từ khóa giúp bạn liên kết các luận điểm..." },
  { id: 'd2', title: "Sơ đồ tư duy Lịch sử 11 - Toàn tập", price: 85000, category: "Sử", grade: "11", pages: 35, format: "PDF", code: "SU11_MAP", description: "Toàn bộ kiến thức giai đoạn kháng chiến chống Pháp qua hình ảnh trực quan.", preview: "Xem trước sơ đồ: Cuộc kháng chiến 1858 tại Đà Nẵng..." },
  { id: 'd3', title: "Kỹ năng xử lý số liệu Địa lí 10", price: 60000, category: "Địa", grade: "10", pages: 40, format: "PDF", code: "DIA10_DATA", description: "Hướng dẫn vẽ biểu đồ và nhận xét bảng số liệu chuẩn xác.", preview: "Cách tính năng suất, mật độ dân số..." },
  { id: 'd4', title: "Phân tích tác phẩm Truyện Kiều (Văn 10)", price: 95000, category: "Văn", grade: "10", pages: 80, format: "PDF", code: "VAN10_KIEU", description: "Tổng hợp các bài văn mẫu và sơ đồ nhân vật Thúy Kiều.", preview: "Phân tích đoạn trích Trao Duyên..." },
];

const COURSES = [
  { id: 'c1', title: "Khóa học: Chinh phục Nghị luận xã hội", price: 450000, category: "Văn", grade: "12", lessons: 15, code: "COURSE_NLXH", description: "Học cách viết đoạn văn 200 chữ đạt điểm tối đa.", trialVideo: "Bản tin học thử: Cách đặt vấn đề trực tiếp." },
];

const EXAMS = [
  { id: 'e1', title: "Đề thi thử THPTQG - Môn Sử", category: "Sử", grade: "12", type: "trắc nghiệm", questions: 40, time: 50, code: "EXAM_SU_2024", canTry: true },
  { id: 'e2', title: "Luyện Nghị luận Văn học - Vợ Chồng A Phủ", category: "Văn", grade: "12", type: "tự luận", questions: 1, time: 90, code: "EXAM_VAN_APHU", canTry: true },
  { id: 'e3', title: "Kiểm tra 1 tiết Địa lý - Lớp 11", category: "Địa", grade: "11", type: "trắc nghiệm", questions: 30, time: 45, code: "EXAM_DIA_11", canTry: false },
];

const App = () => {
  const [user, setUser] = useState(null);
  const [authMode, setAuthMode] = useState(null); 
  const [activeTab, setActiveTab] = useState('home');
  const [unlockedItems, setUnlockedItems] = useState([]);
  const [toast, setToast] = useState(null);
  const [accessCodeInput, setAccessCodeInput] = useState("");
  
  const [selectedGrade, setSelectedGrade] = useState("12");
  const [selectedSubject, setSelectedSubject] = useState("Văn");

  const [viewItem, setViewItem] = useState(null); 
  const [activeExam, setActiveExam] = useState(null);
  const [essayAnswer, setEssayAnswer] = useState("");
  const [aiResult, setAiResult] = useState(null);
  const [loading, setLoading] = useState(false);

  const showToast = (msg, type = 'success') => {
    setToast({ msg, type });
    setTimeout(() => setToast(null), 3000);
  };

  const handleLogin = (e) => {
    e.preventDefault();
    const email = e.target.email.value;
    if (email.includes('admin')) {
      setUser({ name: 'Admin Tiệm Chữ', email, role: 'admin' });
      setActiveTab('admin-stats');
    } else {
      setUser({ name: 'Học viên', email, role: 'student' });
    }
    setAuthMode(null);
    showToast("Chào mừng bạn quay trở lại!");
  };

  const handleVerifyCode = () => {
    const allItems = [...DOCUMENTS, ...COURSES, ...EXAMS];
    const item = allItems.find(i => i.code === accessCodeInput);
    if (item) {
      if (!unlockedItems.includes(accessCodeInput)) {
        setUnlockedItems([...unlockedItems, accessCodeInput]);
        showToast(`Đã mở khóa: ${item.title}`);
      } else showToast("Mã này đã dùng rồi bạn nhé.", "info");
      setAccessCodeInput("");
    } else showToast("Mã không hợp lệ.", "error");
  };

  const checkUnlocked = (code) => unlockedItems.includes(code);

  const handleGradeEssay = async () => {
    setLoading(true);
    const prompt = `Chấm bài văn nghị luận sau và trả về JSON {score, pros[], cons[], advice}: "${essayAnswer}"`;
    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
      });
      const data = await response.json();
      const text = data.candidates?.[0]?.content?.parts?.[0]?.text;
      setAiResult(JSON.parse(text.replace(/```json|```/g, "").trim()));
    } catch (e) { showToast("Lỗi AI chấm bài.", "error"); }
    finally { setLoading(false); }
  };

  const filteredDocs = DOCUMENTS.filter(d => d.grade === selectedGrade && d.category === selectedSubject);
  const filteredExams = EXAMS.filter(e => e.grade === selectedGrade && e.category === selectedSubject);

  return (
    <div className="min-h-screen bg-[#FFFBFB] font-quicksand text-gray-800">
      {/* Navbar */}
      <nav className="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-rose-50 px-8 py-4">
        <div className="max-w-7xl mx-auto flex justify-between items-center">
          <div className="flex items-center gap-10">
            <div className="flex items-center gap-2 cursor-pointer" onClick={() => setActiveTab('home')}>
              <div className="w-8 h-8 bg-rose-500 rounded-xl flex items-center justify-center text-white shadow-md">
                <Feather size={16} />
              </div>
              <h1 className="text-xl font-bold font-playfair text-[#880E4F] italic">Tiệm Chữ 𐙚</h1>
            </div>
            <div className="hidden lg:flex gap-6 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
              <button onClick={() => setActiveTab('home')} className={activeTab === 'home' ? 'text-rose-500' : ''}>Trang chủ</button>
              <button onClick={() => setActiveTab('docs')} className={activeTab === 'docs' ? 'text-rose-500' : ''}>Tài liệu</button>
              <button onClick={() => setActiveTab('exams')} className={activeTab === 'exams' ? 'text-rose-500' : ''}>Luyện đề</button>
            </div>
          </div>
          <div className="flex items-center gap-4">
            <div className="bg-rose-50 p-1 rounded-xl flex border border-rose-100">
              <input value={accessCodeInput} onChange={e => setAccessCodeInput(e.target.value)} placeholder="Nhập mã..." className="bg-transparent px-3 text-[10px] w-24 outline-none font-bold" />
              <button onClick={handleVerifyCode} className="bg-rose-500 text-white px-3 py-1.5 rounded-lg text-[9px] font-bold uppercase">Mở</button>
            </div>
            {user ? (
               <div className="flex items-center gap-3">
                 <button onClick={() => setUser(null)} className="text-gray-300 hover:text-rose-500"><LogOut size={18}/></button>
                 <div className="w-8 h-8 bg-rose-100 rounded-full flex items-center justify-center text-rose-500 text-xs font-bold">{user.name[0]}</div>
               </div>
            ) : (
               <button onClick={() => setAuthMode('login')} className="text-[10px] font-bold uppercase tracking-widest text-[#880E4F] border-b-2 border-rose-200 pb-0.5">Đăng nhập</button>
            )}
          </div>
        </div>
      </nav>

      {/* Trang Chủ */}
      {activeTab === 'home' && (
        <div className="animate-in fade-in duration-700">
          <header className="max-w-4xl mx-auto pt-24 pb-32 px-6 text-center space-y-6">
            <div className="inline-flex items-center gap-2 bg-white px-4 py-1.5 rounded-full border border-rose-100 text-[10px] font-bold tracking-widest text-rose-400 uppercase">
               <Sparkles size={12}/> Hơi thở của văn chương
            </div>
            <h1 className="text-4xl md:text-6xl font-playfair italic font-bold text-gray-900 leading-tight">
              Nơi lưu giữ những<br/>trang chữ dịu dàng nhất
            </h1>
            <p className="max-w-lg mx-auto text-sm text-gray-400 font-medium italic leading-relaxed">
              Tiệm Chữ là góc nhỏ bình yên giúp bạn tìm thấy cảm hứng học tập khối C thông qua những bộ tài liệu và bài giảng được biên soạn tỉ mỉ.
            </p>
            <div className="flex justify-center gap-4 pt-4">
              <button onClick={() => setActiveTab('docs')} className="bg-[#880E4F] text-white px-8 py-3.5 rounded-2xl text-[11px] font-bold shadow-lg hover:scale-105 transition-all">Ghé Tiệm Tài Liệu</button>
              <button onClick={() => setActiveTab('exams')} className="bg-white border border-rose-100 text-rose-500 px-8 py-3.5 rounded-2xl text-[11px] font-bold hover:bg-rose-50 transition-all">Thử Sức Luyện Đề</button>
            </div>
            <div className="pt-16 flex justify-center gap-8 opacity-40">
               <div className="w-20 h-28 bg-rose-100 rounded-xl rotate-[-5deg] flex items-center justify-center text-rose-300"><BookOpen size={32}/></div>
               <div className="w-20 h-28 bg-rose-50 rounded-xl rotate-[10deg] flex items-center justify-center text-rose-200"><Feather size={32}/></div>
               <div className="w-20 h-28 bg-rose-100 rounded-xl rotate-[-8deg] flex items-center justify-center text-rose-300"><Library size={32}/></div>
            </div>
          </header>
        </div>
      )}

      {/* Khu vực Tài liệu & Luyện đề */}
      {(activeTab === 'docs' || activeTab === 'exams') && (
        <div className="max-w-7xl mx-auto py-12 px-6 flex flex-col md:flex-row gap-10">
          {/* Sidebar Bộ lọc */}
          <aside className="w-full md:w-64 space-y-8">
            <div className="bg-white p-6 rounded-3xl border border-rose-50 shadow-sm">
               <h4 className="text-[10px] font-bold uppercase tracking-widest text-gray-300 mb-6">Lọc theo khối</h4>
               <div className="flex flex-col gap-2">
                 {GRADES.map(g => (
                   <button key={g} onClick={() => setSelectedGrade(g)} className={`px-4 py-2.5 rounded-xl text-xs font-bold transition-all text-left ${selectedGrade === g ? 'bg-rose-500 text-white shadow-md' : 'text-gray-400 hover:bg-rose-50'}`}>Lớp {g}</button>
                 ))}
               </div>
            </div>
            <div className="bg-white p-6 rounded-3xl border border-rose-50 shadow-sm">
               <h4 className="text-[10px] font-bold uppercase tracking-widest text-gray-300 mb-6">Môn học</h4>
               <div className="flex flex-col gap-2">
                 {SUBJECTS.map(s => (
                   <button key={s} onClick={() => setSelectedSubject(s)} className={`px-4 py-2.5 rounded-xl text-xs font-bold transition-all text-left ${selectedSubject === s ? 'bg-[#880E4F] text-white shadow-md' : 'text-gray-400 hover:bg-rose-50'}`}>{s}</button>
                 ))}
               </div>
            </div>
          </aside>

          {/* Nội dung chính */}
          <div className="flex-1 space-y-12">
            <div className="flex items-center justify-between border-b border-rose-50 pb-6">
               <h2 className="text-2xl font-bold font-playfair text-[#880E4F]">
                 {activeTab === 'docs' ? 'Thư viện Tài liệu' : 'Phòng Luyện Đề'} Lớp {selectedGrade} - {selectedSubject}
               </h2>
               <div className="text-[10px] font-bold text-gray-300 uppercase italic">🌸 Chất lượng • Uy tín • Dịu dàng</div>
            </div>

            {activeTab === 'docs' ? (
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {filteredDocs.map(doc => (
                  <div key={doc.id} className="bg-white rounded-3xl border border-rose-50 overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col group">
                    <div className="h-40 bg-rose-50 flex items-center justify-center relative overflow-hidden">
                       <FileText size={48} className="text-rose-200 group-hover:scale-110 transition-transform"/>
                       <div className="absolute top-3 right-3 bg-white/80 px-2 py-1 rounded-lg text-[8px] font-bold text-rose-400">{doc.format}</div>
                    </div>
                    <div className="p-6 space-y-4 flex-1 flex flex-col">
                      <h4 className="font-bold text-gray-800 text-sm line-clamp-2 h-10">{doc.title}</h4>
                      <div className="flex items-center justify-between text-[9px] font-bold text-gray-300 uppercase">
                        <span>{doc.pages} Trang</span>
                        <span className="text-rose-400">{doc.price.toLocaleString()}đ</span>
                      </div>
                      <div className="flex gap-2 pt-2">
                         <button onClick={() => setViewItem({ ...doc, type: 'preview' })} className="flex-1 bg-rose-50 text-rose-500 py-2.5 rounded-xl text-[9px] font-bold uppercase flex items-center justify-center gap-1"><Eye size={12}/> Xem thử</button>
                         <button onClick={() => setViewItem({ ...doc, type: 'buy' })} className="flex-1 bg-rose-500 text-white py-2.5 rounded-xl text-[9px] font-bold uppercase shadow-md">Mua ngay</button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="space-y-6">
                {filteredExams.map(exam => (
                  <div key={exam.id} className="bg-white p-6 rounded-3xl border border-rose-50 shadow-sm flex items-center justify-between group hover:border-rose-200 transition-all">
                    <div className="flex items-center gap-6">
                      <div className={`w-14 h-14 rounded-2xl flex items-center justify-center text-white ${exam.type === 'trắc nghiệm' ? 'bg-amber-400' : 'bg-rose-400'}`}>
                        {exam.type === 'trắc nghiệm' ? <ListChecks size={24}/> : <PenTool size={24}/>}
                      </div>
                      <div>
                        <h4 className="font-bold text-gray-800 text-sm">{exam.title}</h4>
                        <p className="text-[9px] font-bold text-gray-300 uppercase tracking-widest mt-1">{exam.questions} Câu • {exam.time} Phút</p>
                      </div>
                    </div>
                    <div className="flex gap-3">
                      {exam.canTry && (
                        <button onClick={() => setActiveExam({ ...exam, isTrial: true })} className="bg-rose-50 text-rose-500 px-5 py-2.5 rounded-xl text-[9px] font-bold uppercase border border-rose-100">Thi thử</button>
                      )}
                      <button onClick={() => checkUnlocked(exam.code) ? setActiveExam(exam) : showToast("Bạn cần mua mã để thi chính thức!", "info")} className="bg-[#880E4F] text-white px-5 py-2.5 rounded-xl text-[9px] font-bold uppercase shadow-sm">Bắt đầu</button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      {/* Khu vực Làm bài */}
      {activeExam && (
        <div className="fixed inset-0 z-[100] bg-white animate-in slide-in-from-bottom-5">
           <div className="max-w-4xl mx-auto py-12 px-6 space-y-8 h-full flex flex-col">
              <div className="flex justify-between items-center">
                 <button onClick={() => setActiveExam(null)} className="flex items-center gap-2 text-gray-400 hover:text-rose-500 font-bold text-[10px] uppercase tracking-widest"><ArrowLeft size={16}/> Quay lại</button>
                 <div className="px-5 py-2 bg-rose-500 text-white rounded-full font-bold text-xs flex items-center gap-2">
                   <Clock size={14}/> {activeExam.time}:00 {activeExam.isTrial && "(Bản thử)"}
                 </div>
              </div>
              <div className="bg-rose-50/50 p-8 rounded-[2.5rem] border border-rose-100 flex-1 flex flex-col">
                 <h2 className="text-2xl font-bold font-playfair text-center mb-10 text-[#880E4F]">{activeExam.title}</h2>
                 
                 {activeExam.type === 'tự luận' ? (
                   <div className="space-y-6 flex-1 flex flex-col">
                      <div className="p-6 bg-white rounded-2xl border border-rose-100 text-sm italic text-gray-500">
                        {activeExam.isTrial ? "[ĐỀ THỬ]: Anh/chị hãy viết đoạn văn 200 chữ về ý nghĩa của sự sẻ chia." : "Đề bài chính thức đang đợi bạn chinh phục..."}
                      </div>
                      <textarea 
                        value={essayAnswer} onChange={e => setEssayAnswer(e.target.value)}
                        placeholder="Cầm bút lên và viết nên những trang chữ của riêng bạn..."
                        className="w-full flex-1 p-8 rounded-2xl bg-white border border-rose-100 outline-none focus:ring-2 ring-rose-200 resize-none text-sm leading-loose"
                      />
                      <button onClick={handleGradeEssay} disabled={loading} className="w-full bg-[#880E4F] text-white py-5 rounded-2xl font-bold text-[11px] uppercase tracking-widest shadow-xl flex items-center justify-center gap-2">
                        {loading ? <Sparkles size={16} className="animate-spin"/> : <Brain size={16}/>} {loading ? 'Đang chấm...' : 'Nộp bài & Chấm AI'}
                      </button>
                   </div>
                 ) : (
                    <div className="flex-1 flex items-center justify-center text-gray-400 italic text-sm">Nội dung đề trắc nghiệm đang tải...</div>
                 )}
              </div>
           </div>
        </div>
      )}

      {/* Modal Xem thử / Mua */}
      {viewItem && (
        <div className="fixed inset-0 z-[100] bg-rose-950/20 backdrop-blur-sm flex items-center justify-center p-4">
           <div className="bg-white w-full max-w-lg rounded-[2.5rem] shadow-2xl p-10 space-y-8 animate-in zoom-in-95">
              <div className="flex justify-between items-start">
                 <div className="flex items-center gap-3">
                    <div className="w-10 h-10 bg-rose-50 rounded-xl flex items-center justify-center text-rose-500"><FileText size={20}/></div>
                    <div>
                       <h3 className="font-bold text-gray-800 text-sm">{viewItem.title}</h3>
                       <p className="text-[9px] font-bold text-gray-300 uppercase tracking-widest">{viewItem.category} Lớp {viewItem.grade}</p>
                    </div>
                 </div>
                 <button onClick={() => setViewItem(null)} className="text-gray-300 hover:text-rose-500"><X size={20}/></button>
              </div>

              {viewItem.type === 'preview' ? (
                <div className="space-y-4">
                   <p className="text-[10px] font-bold text-rose-300 uppercase tracking-widest">Nội dung xem trước (10%):</p>
                   <div className="p-6 bg-rose-50/30 rounded-2xl border border-dashed border-rose-200 text-xs text-gray-500 leading-relaxed italic">
                      {viewItem.preview}
                      <div className="mt-4 text-center text-rose-300">[Phần nội dung còn lại đã bị ẩn]</div>
                   </div>
                   <button onClick={() => setViewItem({...viewItem, type: 'buy'})} className="w-full bg-rose-500 text-white py-4 rounded-2xl font-bold text-[10px] uppercase shadow-lg">Mua để xem toàn bộ</button>
                </div>
              ) : (
                <div className="space-y-6">
                   <div className="p-6 bg-amber-50 rounded-2xl border border-amber-100">
                      <h4 className="text-xs font-bold text-amber-700 mb-2">Thanh toán chuyển khoản</h4>
                      <p className="text-[10px] text-amber-600 leading-relaxed italic">Vui lòng chuyển <b>{viewItem.price.toLocaleString()}đ</b> tới STK 12345678 - MB Bank (Nội dung: {viewItem.code}). Mã mở khóa sẽ được gửi vào email của bạn sau 1-5 phút.</p>
                   </div>
                   <button onClick={() => { setViewItem(null); showToast("Đã gửi yêu cầu thanh toán!", "info"); }} className="w-full bg-[#880E4F] text-white py-4 rounded-2xl font-bold text-[10px] uppercase shadow-lg">Tôi đã thanh toán</button>
                </div>
              )}
           </div>
        </div>
      )}

      {/* Auth Modal */}
      {authMode && (
         <div className="fixed inset-0 z-[100] bg-rose-950/20 backdrop-blur-sm flex items-center justify-center p-4">
           <form onSubmit={handleLogin} className="bg-white w-full max-w-xs rounded-[2.5rem] shadow-2xl p-10 space-y-6 animate-in zoom-in-95 relative">
              <button type="button" onClick={() => setAuthMode(null)} className="absolute top-6 right-6 text-gray-300"><X size={18}/></button>
              <div className="text-center space-y-2">
                 <h3 className="text-xl font-bold font-playfair text-[#880E4F]">Ghé Tiệm</h3>
                 <p className="text-[10px] text-gray-400 italic">Dành cho những tâm hồn mộng mơ</p>
              </div>
              <input name="email" type="email" required placeholder="Email của bạn..." className="w-full px-5 py-3 rounded-xl bg-rose-50 text-xs outline-none focus:ring-1 ring-rose-200 font-medium" />
              <input name="password" type="password" required placeholder="Mật khẩu..." className="w-full px-5 py-3 rounded-xl bg-rose-50 text-xs outline-none focus:ring-1 ring-rose-200 font-medium" />
              <button className="w-full bg-[#880E4F] text-white py-3.5 rounded-xl font-bold text-[10px] uppercase shadow-lg">Xác nhận</button>
           </form>
         </div>
      )}

      {/* Toast */}
      {toast && (
        <div className={`fixed bottom-10 left-1/2 -translate-x-1/2 px-8 py-4 rounded-full text-white font-bold text-[10px] uppercase tracking-widest z-[200] animate-in slide-in-from-bottom-5 shadow-2xl ${toast.type === 'error' ? 'bg-red-500' : 'bg-[#AD1457]'}`}>
          {toast.msg}
        </div>
      )}

      <footer className="py-20 bg-white border-t border-rose-50 text-center space-y-6">
         <div className="flex justify-center gap-2">
            <div className="w-6 h-6 bg-rose-100 rounded-lg flex items-center justify-center text-rose-500"><Feather size={12}/></div>
            <span className="text-xs font-bold font-playfair text-[#880E4F]">Tiệm Chữ 𐙚</span>
         </div>
